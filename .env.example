# PayPal Configuration
# Copia questo file come .env e inserisci le tue credenziali PayPal

# Modalità: sandbox (per testing) o production (per ambiente live)
PAYPAL_MODE=sandbox

# Credenziali PayPal
# Ottieni queste credenziali dal PayPal Developer Dashboard:
# https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_client_secret_here

# Server Configuration (opzionale)
PORT=3000

# IMPORTANTE:
# - Non committare mai il file .env nel repository
# - Il file .env è già incluso nel .gitignore
# - In production, usa variabili d'ambiente del tuo hosting provider
